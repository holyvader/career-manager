# Copy this file to .env.production and fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# Never commit the filled-in file - it will hold real secrets.

# --- Reverse proxy / TLS (Caddy) ---
# Real domains you own, each with DNS pointing at this server - Caddy uses
# these to request/renew Let's Encrypt certificates automatically (see
# Caddyfile). For a local smoke test without real domains, set both to
# `localhost` instead (Caddy then uses a self-signed cert, no ACME).
# Keep these in sync with BETTER_AUTH_URL/FRONTEND_URL/NEXT_PUBLIC_BACKEND_URL
# below - Caddy's routing and the app's own URL env vars are configured
# independently and won't automatically match each other.
FRONTEND_DOMAIN=app.yourdomain.example
BACKEND_DOMAIN=api.yourdomain.example
# Used for Let's Encrypt renewal notices, not shown to users.
CADDY_EMAIL=you@example.com

# --- Database ---
# Full Postgres connection string, e.g.
#   postgres://USER:PASSWORD@db:5432/career_manager
# ("db" is the bundled Postgres service's hostname on the compose network -
# use your managed Postgres host instead if you're not using that service).
# Left empty on purpose for now - the backend container will build and start
# fine, but will fail at its migration step until this is set to a real,
# reachable database.
DATABASE_URL=

# Only used by the bundled `db` service in docker-compose.prod.yml - ignored
# entirely if DATABASE_URL points at an external/managed Postgres instead.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=career_manager

# --- Auth (better-auth) ---
# Generate a real secret, e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL the backend itself is reachable at (used for auth callback
# URLs) - should be `https://` + BACKEND_DOMAIN above.
BETTER_AUTH_URL=https://api.yourdomain.example
# Public URL of the frontend (CORS allow-origin, links in outgoing emails)
# - should be `https://` + FRONTEND_DOMAIN above.
FRONTEND_URL=https://app.yourdomain.example

# --- Frontend ---
# Public URL the end user's BROWSER uses to reach the backend - should be
# `https://` + BACKEND_DOMAIN above (not a Docker-internal hostname like
# http://backend:3334 - the browser can't resolve that). This is baked into
# the frontend's client-side JS bundle at BUILD time (Next.js inlines all
# NEXT_PUBLIC_* vars), so changing it requires rebuilding the frontend image
# (`docker compose ... build frontend`) - a running container won't pick up
# a change to this var on its own.
NEXT_PUBLIC_BACKEND_URL=https://api.yourdomain.example

# --- Outgoing email (SMTP) - see packages/backend/src/email/mailer.ts ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_SSL=false

# --- Logging (optional) ---
LOG_LEVEL=info
# Ships structured backend logs to Loki - only takes effect if you also run
# the `observability` profile (see docker-compose.prod.yml). Leave empty to
# only log to stdout.
LOKI_HOST=http://loki:3100

# --- Grafana (optional - only used with the `observability` profile) ---
GRAFANA_ADMIN_PASSWORD=
