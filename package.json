{
	"name": "career-manager",
	"version": "1.0.0",
	"workspaces": [
		"packages/*"
	],
	"packageManager": "bun@1.4.0",
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.0"
		}
	},
	"scripts": {
		"app:lint": "biome lint .",
		"app:lint:fix": "biome lint --write .",
		"app:lint:fix:unsafe": "biome lint --write --unsafe .",
		"app:format": "biome format --write .",
		"app:check": "biome check --write .",
		"app:backend:docker": "docker compose -f docker-compose.backend.yml up",
		"app:backend:docker:down": "docker compose -f docker-compose.backend.yml down"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"bun": "^1.4.0",
		"turbo": "^2.10.12"
	},
	"catalogs": {
		"linting": {
			"@biomejs/biome": "^2.5.9"
		},
		"backend": {
			"@prisma/adapter-pg": "^7.9.1",
			"@prisma/client": "^7.9.1",
			"better-auth": "^1.7.1",
			"dotenv": "^17.4.2",
			"elysia": "latest",
			"pg": "^8.23.0",
			"pino": "^10.3.1",
			"pino-loki": "^3.0.0",
			"pino-pretty": "^13.1.1",
			"tsx": "^4.23.12"
		},
		"backend-dev": {
			"@types/pg": "^8.21.0",
			"bun-types": "latest",
			"prisma": "^7.9.1"
		}
	}
}
