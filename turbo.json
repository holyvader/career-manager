{
	"$schema": "https://turborepo.dev/schema.json",
	"remoteCache": {
		"enabled": false
	},
	"cacheDir": ".turbo",
	"tasks": {
		"build": {
			"outputs": ["dist/**"]
		},
		"dev": {
			"persistent": true,
			"cache": false,
			"dependsOn": ["app:backend:docker:up"]
		},
		"lint": {
			"cache": false
		},
		"format": {
			"cache": false
		},
		"check": {
			"cache": false
		},
		"app:backend:docker:up": {
			"cache": false
		},
		"app:backend:docker:down": {
			"cache": false
		}
	}
}
